<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zinc</AssemblyName>
    <RootNamespace>Zinc</RootNamespace>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="1.2.7" />
    <PackageReference Include="Arch.AOT.SourceGenerator" Version="1.0.1" />
    <PackageReference Include="Depot.SourceGenerator" Version="1.0.9" />
    <PackageReference Include="Zinc.ECSGenerator" Version="1.3.2" />
    <PackageReference Include="Zinc.Magic" Version="1.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <ZincNativeLibExcludes>libs\runtimes\**\*.lib</ZincNativeLibExcludes>
    <ZincNativeLibExcludes Condition="'$(Configuration)' == 'Release'">$(ZincNativeLibExcludes);libs\runtimes\**\*.pdb</ZincNativeLibExcludes>
  </PropertyGroup>

  <ItemGroup>
      <Content Include="data\**\*">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <!-- .lib import libs only matter when linking native code against the dlls, never at runtime.
           Native .pdb symbols are only for debugging into the natives, so Release leaves them behind. -->
      <Content Include="libs\runtimes\**\*" Exclude="$(ZincNativeLibExcludes)">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <PackagePath>runtimes</PackagePath>
          <!-- Single-file publish: the SDK takes any .dll for a managed assembly and queues it for
               the bundle, the bundler then rejects it as native, and it ends up neither bundled nor
               copied. NativeLibResolver loads these from disk anyway, so keep them out of the bundle. -->
          <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
  </ItemGroup>

      <PropertyGroup>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

  <!-- <ItemGroup>
    <Folder Include="data\fonts\" />
  </ItemGroup> -->

  <!-- Run sokol-shdc on res/**/*.glsl at build and feed reflection to Zinc.Magic. -->
  <Import Project="Zinc.Shaders.targets" />

</Project>
